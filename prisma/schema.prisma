generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum PostAuthorType {
  USER
  OFFICIAL_BOT
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  username             String?             @unique
  bio                  String?             @db.Text
  email                String              @unique
  /// Kanonik e-posta (gmail/googlemail: `+etiket` ve noktalar atılır, alan gmail.com) — aynı kutuya ikinci hesap ve
  /// ikinci kayıt bonusu engellenir (lib/emailNormalize.ts). 2026-10-04'ten önceki kayıtlarda boş (geri doldurulmadı).
  emailNormalized      String?             @unique
  emailVerified        DateTime?
  password             String?
  /// Oturum sürümü: şifre değişince / sıfırlanınca artar; web oturumu ve mobil belirteç bu değeri taşır, her
  /// kimlik kontrolünde karşılaştırılır (eşleşmeyen oturum geçersiz).
  tokenVersion         Int                 @default(0)
  image                String?
  role                 Role                @default(USER)
  /// AI analiz kredisi bakiyesi (süresiz). Yeni kullanıcı 0 ile başlar; e-posta doğrulanınca 2 kredi kayıt bonusu
  /// (lib/credits.ts → grantVerifiedSignupBonus). 2026-10 öncesi kayıtlar 5 ile başlamıştı (bakiyeleri aynen kalır).
  credits              Int                 @default(0)
  /// Premium bitişi: > şimdi ⇒ premium (sınırsız analiz açma, reklamsız). Yönetici panelinden elle; ileride ödemeden.
  premiumUntil         DateTime?
  /// Davet kodu (ilk istekte üretilir) ve kaydı getiren davet edenin kimliği (ödül ödeme entegrasyonunda).
  referralCode         String?             @unique
  referredById         String?
  favoriteTeamIds      Int[]
  favoriteLeagueIds    Int[]
  /// Kayıt kaynağı (ilk temas): kayıt oturumunun ilk sayfasındaki utm_* değerleri ve o oturumun ilk giriş
  /// zamanı. Tarayıcıda yalnız oturum boyunca (sessionStorage) tutulur; kayıtta bir kez yazılır.
  signupUtmSource      String?
  signupUtmMedium      String?
  signupUtmCampaign    String?
  firstTouchAt         DateTime?
  /// Kayıtta Kullanım Koşulları + Gizlilik Politikası onayı: zaman ve metin sürümü (config/legalConsent.ts →
  /// TERMS_CONSENT_VERSION). 2026-10-14 öncesi kayıtlarda ve Google / mobil ile açılan hesaplarda boş.
  termsAcceptedAt      DateTime?
  termsVersion         String?
  /// Gündem yazma askısı (yönetici kararı): > şimdi ⇒ gönderi / yorum yazamaz; giriş ve okuma açık. Kalıcı askı
  /// 9999-12-31 (lib/moderation/suspension.ts). Boş = askı yok.
  gundemSuspendedUntil DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  accounts             Account[]
  sessions             Session[]
  comments             MatchComment[]      @relation("MatchCommentAuthor")
  deletedComments      MatchComment[]      @relation("MatchCommentDeletedBy")
  commentLikes         MatchCommentLike[]
  userPredictions      UserPrediction[]
  creditTransactions   CreditTransaction[]
  analysisUnlocks      AnalysisUnlock[]
  premiumGrants        PremiumGrant[]
  paymentOrders        PaymentOrder[]
  posts                Post[]              @relation("PostAuthor")
  deletedPosts         Post[]              @relation("PostDeletedBy")
  postLikes            PostLike[]          @relation("PostLikeUser")
  postComments         PostComment[]       @relation("PostCommentAuthor")
  deletedPostComments  PostComment[]       @relation("PostCommentDeletedBy")
  following            Follow[]            @relation("FollowFollower")
  followers            Follow[]            @relation("FollowFollowing")
  pushTokens           PushToken[]
  notifications        Notification[]      @relation("NotificationRecipient")
  notificationsAsActor Notification[]      @relation("NotificationActor")
  pinBids              PinBid[]
  couponRedemptions    CouponRedemption[]
  frikikScores         FrikikDailyScore[]
  blocksMade           UserBlock[]         @relation("UserBlockBlocker")
  blockedBy            UserBlock[]         @relation("UserBlockBlocked")
  reportsMade          ContentReport[]     @relation("ContentReportReporter")
  reportsResolved      ContentReport[]     @relation("ContentReportResolver")
  mentionsReceived     GundemMention[]     @relation("GundemMentionUser")
  moderationActions    ModerationAction[]  @relation("ModerationActionAdmin")
  moderationTargeted   ModerationAction[]  @relation("ModerationActionTarget")
  gamePredictions      GamePrediction[]
  gameWeekEntries      GameWeekEntry[]
}

/// Kredi hareketleri defteri — bakiye değişikliklerinin denetim izi.
model CreditTransaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "SIGNUP_BONUS" | "PURCHASE" | "ANALYSIS_SPEND" | "ANALYSIS_FREE" | "ANALYSIS_PREMIUM" | "ANALYSIS_WEEKLY_FREE"
  /// | "ADMIN_GRANT" | "REFUND" | "REFERRAL_BONUS". Hiçbir tür maç sonucuna / tahmine bağlı DEĞİL.
  type           String
  /// Pozitif (ekleme) veya negatif (harcama)
  amount         Int
  balanceAfter   Int
  /// ANALYSIS_SPEND için ilgili maç
  matchId        String?
  note           String?
  /// Harcamanın tekrar anahtarı (kullanıcı başına tekil): aynı iş için en fazla bir düşüm. Analiz:
  /// `analysis:{matchId}:PRE`. İade edilince anahtar `…:refunded:{id}` olur (yeniden denenebilsin). Eski satırlarda null.
  idempotencyKey String?
  /// Harcama durumu: "PENDING" (üretim sürüyor) | "SETTLED" | "REFUNDED". Diğer tiplerde ve eski satırlarda null.
  status         String?
  /// REFUND satırı → iade ettiği harcama (tekil: bir harcama en fazla bir kez iade edilir).
  refundOfId     String?  @unique
  /// Yönetici işlemlerinde (ADMIN_GRANT) işlemi yapan yöneticinin kimliği — denetim izi.
  actorId        String?
  createdAt      DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([matchId])
  @@index([status, createdAt])
}

/// Kullanıcının açtığı (PRE) analiz — erişimin tek kaydı; açılan analiz kalıcı açık kalır.
/// source: "CREDIT" | "WEEKLY_FREE" | "PREMIUM" | "ADMIN" | "LEGACY" (2026-10 öncesi üretenler)
model AnalysisUnlock {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchAnalysisId     String
  matchAnalysis       MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)
  matchId             String
  source              String
  /// Açmayı ödeyen / kaydeden defter satırı (kredi, haftalık hak, premium 0 tutarlı)
  creditTransactionId String?       @unique
  createdAt           DateTime      @default(now())

  @@unique([userId, matchAnalysisId])
  @@index([matchAnalysisId])
  @@index([userId, createdAt])
}

/// Premium değişikliklerinin denetim izi. source: "ADMIN" | "PURCHASE"; until null = kaldırıldı.
model PremiumGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  until     DateTime?
  source    String
  actorId   String?
  note      String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Hikie ödemesi (Checkout Link). Kredi kararı YALNIZ imzalı order.paid webhook'undan verilir; imzasız
/// callback yalnız callbackAt işaretler, tarayıcı yönlendirmesi hiçbir şey vermez (bkz. server/payments). merchantOrderId bizim ürettiğimiz, linke eklenen kimlik;
/// hikieOrderId Hikie'nin invoiceId'si (ödeme sonuçlanınca, tekil → aynı ödeme iki kez işlenmez).
model PaymentOrder {
  id                      String             @id @default(cuid())
  merchantOrderId         String             @unique
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// config/paymentPackages.ts anahtarı (credits_10, credits_30, credits_100, test_1tl; eski premium_* katalogda yok)
  packageKey              String
  amountTRY               Decimal            @db.Decimal(10, 2)
  status                  PaymentOrderStatus @default(PENDING)
  hikieOrderId            String?            @unique
  createdAt               DateTime           @default(now())
  paidAt                  DateTime?
  refundedAt              DateTime?
  /// İmzasız Checkout Link callback'i ilk ne zaman geldi (yalnız tanılama; kredi kararı değil).
  callbackAt              DateTime?
  /// Sipariş öncesi onay (Ön Bilgilendirme Formu + Mesafeli Satış Sözleşmesi + anında ifa / cayma hakkı beyanı): zaman
  /// ve metin sürümü (config/legalConsent.ts PURCHASE_TERMS_VERSION). Bu alanlar eklenmeden önceki siparişlerde null.
  termsAcceptedAt         DateTime?
  termsVersion            String?
  /// Sipariş onay e-postasının dili ("tr" | "en"; checkout anındaki site dili). Eski siparişlerde null → tr.
  locale                  String?
  /// Sipariş onay e-postası gönderildi (tek sefer: koşullu güncelleme ile talep edilir; gönderim başarısızsa geri null).
  confirmationEmailSentAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// İşlenmiş Hikie webhook'ları (Hikie-Webhook-Id) — aynı teslimat ikinci kez işlenmez.
model PaymentWebhookEvent {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())
}

/// Arkadaş daveti. Ödül (iki tarafa 2 kredi) davet edilenin İLK SATIN ALIMINDA — ödeme entegrasyonunda bağlanacak.
model Referral {
  id         String    @id @default(cuid())
  referrerId String
  refereeId  String    @unique
  createdAt  DateTime  @default(now())
  rewardedAt DateTime?

  @@index([referrerId, createdAt])
}

/// AI üretimli maç analizi cache'i. Aynı maç + status için tek aktif kayıt.
model MatchAnalysis {
  id                String            @id @default(cuid())
  matchId           String
  /// "PRE" (maç öncesi) | "HT" (devre arası) | "POST" (maç sonu)
  matchStatus       String
  modelVersion      String
  /// Takım kimlikleri ve adları (denormalize — analiz görüntülemede tek sorgu)
  homeTeamId        String?
  awayTeamId        String?
  homeTeamName      String
  awayTeamName      String
  competitionId     String?
  competitionName   String?
  /// Hızlı erişim için takım anlatımları ayrıca tutulur
  homeTeamNarrative String            @db.Text
  awayTeamNarrative String            @db.Text
  /// Yapılandırılmış AI çıktıları (Json)
  matchPrediction   Json
  scorePrediction   Json
  goalExpectation   Json
  bettingTips       Json
  teamAnalyses      Json
  /// v2 promptun geniş bölümleri (matchSummary, tacticalAnalysis, heatmapAnalysis,
  /// playerAnalysis, riskFactors, finalVerdict, analystComment)
  fullReport        Json?
  /// "low" | "medium" | "high"
  riskLevel         String
  riskReasoning     String            @db.Text
  /// 0-100 arası modelin kendi güven skoru
  confidenceScore   Float
  /// Maliyet takibi
  tokensUsed        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  /// PRE fazında 30 dk TTL; HT/POST için null (kalıcı)
  expiresAt         DateTime?
  predictionRecord  PredictionRecord?
  unlocks           AnalysisUnlock[]

  @@unique([matchId, matchStatus])
  @@index([matchId])
}

/// Tahmin doğruluk takibi — maç bittiğinde MatchAnalysis ile karşılaştırılır.
model PredictionRecord {
  id                  String        @id @default(cuid())
  matchAnalysisId     String        @unique
  matchAnalysis       MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)
  matchId             String
  matchLabel          String?
  predictedHomePct    Float
  predictedDrawPct    Float
  predictedAwayPct    Float
  predictedScore      String
  predictedOver25     Float
  predictedBtts       Float
  /// "HOME" | "DRAW" | "AWAY"
  actualResult        String?
  actualScore         String?
  actualOver25        Boolean?
  actualBtts          Boolean?
  /// 1X2 isabetli mi (en yüksek olasılığa sahip outcome doğru çıktı mı)
  result1x2Hit        Boolean?
  scoreExactHit       Boolean?
  /// v2 pazarların tahmin değerleri (over35, htOver05, htOver15, homeToScore,
  /// awayToScore, bttsFirstHalf)
  extendedPredictions Json?
  /// Maç bitince hesaplanan isabet/ıska sonuçları (over25Hit, bttsHit, over35Hit,
  /// htOver05Hit, htOver15Hit, homeToScoreHit, awayToScoreHit, bttsFirstHalfHit)
  extendedHits        Json?
  modelVersion        String
  evaluatedAt         DateTime?
  createdAt           DateTime      @default(now())

  @@index([matchId])
  @@index([modelVersion, result1x2Hit])
}

/// Kullanıcı maç tahmini — topluluk anketi için (1X2 oyu).
model UserPrediction {
  id         String   @id @default(cuid())
  matchId    String
  userId     String
  /// "HOME" | "DRAW" | "AWAY"
  prediction String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
}

model MatchComment {
  id              String             @id @default(cuid())
  matchId         String
  body            String             @db.Text
  createdAt       DateTime           @default(now())
  userId          String
  user            User               @relation("MatchCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?              @relation("MatchCommentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  likes           MatchCommentLike[]

  @@index([matchId, createdAt])
}

/// Maç yorumu beğenisi — kullanıcı başına yorum başına tek kayıt (toggle).
model MatchCommentLike {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime     @default(now())
  comment   MatchComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

/// AI üretimli maç trivia/fun-facts cache'i. Aynı maç + status için tek aktif kayıt.
model MatchTrivia {
  id             String    @id @default(cuid())
  matchId        String
  /// "PRE" | "HT" | "POST"
  matchStatus    String
  /// Ertem Şener tarzı absürd ama gerçek istatistikler (string[])
  ertemFacts     Json
  /// Transfer/kariyer bağlam anlatısı
  contextual     String    @db.Text
  /// Tarihi husumeti ve rekabet bağlamı
  rivalryContext String    @db.Text
  modelVersion   String
  tokensUsed     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  /// PRE fazında 2 saat TTL; HT/POST için null (kalıcı)
  expiresAt      DateTime?

  @@unique([matchId, matchStatus])
  @@index([matchId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Gündem (sosyal akış) postu. Resmi/otomatik postlar OFFICIAL_BOT; yazarı bot User kaydıdır.
model Post {
  id              String          @id @default(cuid())
  authorId        String
  author          User            @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorType      PostAuthorType  @default(USER)
  body            String          @db.Text
  matchId         String?
  teamId          Int?
  /// Bot postlarının tekrar üretimini engelleyen anahtar (örn. "goal:<matchId>:<eventId>")
  externalKey     String?         @unique
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?           @relation("PostDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  /// Moderasyonla gizlendi (şikâyet eşiği ya da yönetici): yazar görür ("inceleme altında"), diğerleri görmez.
  hiddenAt        DateTime?
  /// "REPORTS" (eşik) | "ADMIN"
  hiddenReason    String?
  likes           PostLike[]
  comments        PostComment[]
  notifications   Notification[]
  reports         ContentReport[]
  mentions        GundemMention[]

  @@index([createdAt])
  @@index([authorType, createdAt])
  @@index([authorId, createdAt])
  @@index([matchId, createdAt])
}

/// Maça bağlı Gündem postlarının rozet verisi (takım adları/logoları, başlama saati). `Post.matchId` ile
/// ilişkisiz lookup: FK yok — mevcut matchId'li postların snapshot'ı olmayabilir ve snapshot'ın sağlayıcıdan
/// çözülememesi bot postunu engellememeli. Akış sayfası başına tek `fixtureId IN (...)` sorgusuyla okunur.
model MatchSnapshot {
  /// Sportmonks fixture id — `Post.matchId` ile aynı tip (String) ve biçim.
  fixtureId     String   @id
  homeTeamId    Int
  homeName      String
  homeShortName String?
  homeLogo      String?
  awayTeamId    Int
  awayName      String
  awayShortName String?
  awayLogo      String?
  startingAt    DateTime
  leagueId      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Post beğenisi — kullanıcı başına post başına tek kayıt (toggle).
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id              String          @id @default(cuid())
  postId          String
  post            Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("PostCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  body            String          @db.Text
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?           @relation("PostCommentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  /// Moderasyonla gizlendi (bkz. Post.hiddenAt)
  hiddenAt        DateTime?
  hiddenReason    String?
  reports         ContentReport[]
  mentions        GundemMention[]

  @@index([postId, createdAt])
}

/// Kullanıcı takibi. followerId, followingId'yi takip eder. Kendini takip API'de engellenir.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Cihaz push token'ı (Expo push token; ileride web push endpoint'i de aynı tabloya).
model PushToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  /// "ios" | "android" | "web"
  platform   String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Expo "DeviceNotRegistered" dönerse set edilir, gönderim atlanır
  disabledAt DateTime?

  @@index([userId])
}

/// Uygulama içi bildirim (zil). Push gönderimi bunun yan etkisidir.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// "POST_LIKE" | "POST_COMMENT" | "FOLLOW" | "OFFICIAL_POST" | "MENTION" | "MODERATION_WARNING"
  type      String
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt, createdAt])
}

/// Gündem resmi hesap botu taslağı (onay kuyruğu). Poller üretir (PENDING), admin onaylar/reddeder; onayda VAR yeniden doğrulaması
/// başarısızsa STALE. Yayınlanınca Post.id `postId`'ye yazılır. `externalKey` tek kez işlemeyi garanti eder.
enum BotDraftStatus {
  PENDING
  APPROVED
  REJECTED
  POSTED
  STALE
}

model GundemBotDraft {
  id          String         @id @default(cuid())
  /// goal:<fixtureId>:<eventId> (v1 yalnızca GOAL; ht:/ft: ileride)
  externalKey String         @unique
  /// "GOAL" | "HT" | "FT"
  kind        String
  fixtureId   Int
  eventId     Int?
  /// Şablon çıktısı; onayda elle düzenlenebilir.
  body        String         @db.Text
  /// GoalFacts (denetim için).
  facts       Json
  warnings    String[]
  status      BotDraftStatus @default(PENDING)
  /// Yayınlanınca Post.id.
  postId      String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([status, createdAt])
  @@index([fixtureId])
}

/// Frikik (günün frikiği) skor tablosu: kullanıcı + gün başına TEK kayıt (günün ilk bitmiş koşusu). Skor istemciden
/// alınmaz; sunucu vuruş girdilerini sim.ts ile yeniden oynatır (lib/frikik/scoreSubmit.ts). `day` / `month` TR takvimi
/// ("YYYY-MM-DD" / "YYYY-MM", lib/frikik/daily.ts). Sıralama: level DESC, score DESC, createdAt ASC. Aylık tablo
/// kullanıcı başına ay içindeki en iyi kayıt. Tabloda görünen ad User.username (e-posta / gerçek ad asla).
model FrikikDailyScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String
  month      String
  score      Int
  level      Int
  cleared    Int
  /// Yeniden oynatmada kullanılan simülasyon sürümü (lib/frikik/sim.ts SIM_VERSION); sürüm değişince eski kayıtlar
  /// karşılaştırılabilir kalır ama yeniden üretilemez.
  simVersion Int
  seed       Int
  shots      Int
  createdAt  DateTime @default(now())

  @@unique([userId, day])
  @@index([day, level, score])
  @@index([month, userId])
}

/// Hesap silme denetim kaydı — KİŞİSEL VERİ YOK: kullanıcı kimliği, e-posta, ad, IP tutulmaz (kişiyle eşleştirilemez).
/// Yalnız silmenin yapıldığı, kanalı ve neyin silindiği / anonimleştirildiği (sayılar). Saklama süresi avukata soruldu
/// (docs/YASAL_NOTLAR.md → "Hesap silme ve saklama süreleri"). Bkz. server/account/deleteAccount.ts.
model AccountDeletionLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  /// "web" (oturum çerezi) | "mobile" (Bearer belirteç)
  source         String
  /// Hesabın giriş yöntemleri: şifre vardı mı, bağlı OAuth sağlayıcıları ("google" …)
  hadPassword    Boolean
  oauthProviders String[]
  /// Hesap yaşı (gün, aşağı yuvarlanmış) — kesin kayıt tarihi tutulmaz.
  accountAgeDays Int
  /// { postsAnonymized, postCommentsAnonymized, matchCommentsAnonymized, paymentOrdersDetached, ... } sayıları
  counts         Json

  @@index([createdAt])
}

/// Kullanıcı engeli: blocker, blocked'ın içeriğini / bildirimlerini görmez; blocked, blocker'ı etiketleyemez ve ona
/// bildirim üretemez. Engellenen tarafa hiçbir yanıtta söylenmez. Hesap silinince iki yönde de CASCADE.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Gündem şikâyeti (gönderi / yorum / kullanıcı). `targetKey` = "post:<id>" | "comment:<id>" | "user:<id>" — kullanıcı
/// başına hedef başına tek şikâyet. `source` "USER" (kullanıcı) | "AUTO" (filtre ORTA seviye işareti; reporterId boş).
/// Şikâyet eden hesabını silerse reporterId boşalır (kuyruk kaybolmaz). Şikâyet edenin kimliği hiçbir yanıtta yok.
model ContentReport {
  id           String       @id @default(cuid())
  targetKey    String
  /// "POST" | "COMMENT" | "USER"
  targetType   String
  postId       String?
  commentId    String?
  targetUserId String?
  reporterId   String?
  source       String       @default("USER")
  /// HARASSMENT | HATE | SPAM | SEXUAL | VIOLENCE | MISINFO | OTHER | AUTO_*
  reason       String
  note         String?
  /// "OPEN" | "RESOLVED" | "DISMISSED"
  status       String       @default("OPEN")
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter     User?        @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("ContentReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([targetKey, reporterId])
  @@index([status, createdAt])
  @@index([targetKey, status])
  @@index([reporterId, createdAt])
}

/// Gönderi / yorumdaki doğrulanmış @etiket (yazma anında çözülür; metin düz "@kullaniciadi" kalır). En fazla 5 / içerik.
model GundemMention {
  id              String       @id @default(cuid())
  /// "post:<id>" | "comment:<id>"
  targetKey       String
  postId          String?
  commentId       String?
  mentionedUserId String
  /// Metinde yazıldığı biçim (küçük harf); gösterimde eşleştirme için.
  username        String
  createdAt       DateTime     @default(now())
  post            Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment         PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser   User         @relation("GundemMentionUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([targetKey, mentionedUserId])
  @@index([postId])
  @@index([commentId])
  @@index([mentionedUserId])
}

/// Yönetici moderasyon işlemleri denetim kaydı: kim (adminId), ne zaman, ne yaptı, hangi hedef. Kişisel veri en az:
/// içerik metni / e-posta tutulmaz; not yöneticinin kısa açıklaması.
model ModerationAction {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  adminId      String?
  /// HIDE | UNHIDE | DELETE | DISMISS | WARN | SUSPEND | UNSUSPEND | TERM_ADD | TERM_REMOVE
  action       String
  targetKey    String?
  targetUserId String?
  reportCount  Int?
  note         String?
  /// İşleme özel küçük ayrıntılar (askı süresi gün, terim seviyesi …)
  meta         Json?
  admin        User?    @relation("ModerationActionAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("ModerationActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId])
}

/// Filtre sözlüğüne kod değişmeden ek: yöneticinin eklediği terimler (BLOCK: AĞIR / FLAG: ORTA) ve istisnalar (ALLOW:
/// yanlış pozitif veren kelime). Temel liste src/config/moderation/terms.tr.json; bu tablo onu genişletir.
model ModerationTerm {
  id        String   @id @default(cuid())
  term      String   @unique
  /// "BLOCK" | "FLAG" | "ALLOW"
  level     String
  /// "exact" | "prefix" | "contains"
  match     String   @default("prefix")
  category  String   @default("custom")
  createdAt DateTime @default(now())
}

/// Reddedilen / işaretlenen içerik sayaçları — kişisel veri yok (gün + yüzey + kategori + sayı).
model ModerationStat {
  id       String   @id @default(cuid())
  day      DateTime @db.Date
  /// "post" | "comment" | "profile"
  surface  String
  /// profanity | sexual | hate | threat | spam_links | duplicate | flag_* …
  category String
  /// "rejected" | "flagged"
  outcome  String
  count    Int      @default(0)

  @@unique([day, surface, category, outcome])
}

/// Gündem 1. sıra teklifi (haftalık açık artırma; kurallar: src/lib/pinBid.ts). Haftada en fazla bir ACTIVE (kısmi tekil
/// indeks, migration 20261019120000). Teklif tutarı verilirken düşülür (defter `PIN_BID`); sıra kaybedilince başlayan gün
/// oranında kesinti, kalanı `PIN_REFUND`. Hafta sonunda lider olan teklifin tamamı kullanılmış sayılır (iade yok).
model PinBid {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Haftanın başlangıcı: Pazartesi 01:00 Europe/Istanbul (UTC olarak saklanır)
  weekStart      DateTime
  amount         Int
  message        String
  /// "ACTIVE" | "OUTBID" | "REMOVED" (yönetici) | "COMPLETED" (hafta sonunda lider)
  status         String    @default("ACTIVE")
  chargedAmount  Int?
  refundedAmount Int?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([weekStart, status])
  @@index([userId])
}

/// Kupon kodu (ör. FUTBOL10 → +10 kredi). Kod BÜYÜK harfle saklanır; kullanıcı başına bir kez kullanılır.
model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  credits        Int
  /// null = sınırsız toplam kullanım
  maxRedemptions Int?
  redeemedCount  Int                @default(0)
  expiresAt      DateTime?
  active         Boolean            @default(true)
  note           String?
  createdAt      DateTime           @default(now())
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits   Int
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

/// Tahmin oyunu (ücretsiz, ödülsüz skor tahmini; ad config/brand.ts GAME_BRAND). Plan: docs/TAHMIN_OYUNU_PLANI.md.
/// Hafta: TR ISO haftası, Pazartesi 00:00 – Pazar 23:59 Europe/Istanbul. Kilit maç başına, `GameMatch.kickoffAt`'te; yazım
/// tek koşullu SQL ile ve veritabanı saatiyle (lib/game/sql.ts).
enum GameWeekStatus {
  DRAFT
  PUBLISHED
  SETTLED
}

enum GameMatchStatus {
  SCHEDULED
  FINISHED
  VOID
}

/// Oyun haftası. `weekKey` "2026-W42"; `season` "2026-27"; `startsAt`/`endsAt` UTC (hafta TR'de Pzt 00:00 / sonraki Pzt 00:00).
model GameWeek {
  id             String          @id @default(cuid())
  weekKey        String          @unique
  season         String
  status         GameWeekStatus  @default(DRAFT)
  scoringVersion Int             @default(1)
  startsAt       DateTime
  endsAt         DateTime
  publishedAt    DateTime?
  publishedById  String?
  settledAt      DateTime?
  /// Admin listeyi elle değiştirdi → otomatik seçim (game-settle) bu haftaya dokunmaz. "Otomatiğe bırak" false yapar.
  lockedByAdmin  Boolean         @default(false)
  /// Otomatik doldurmanın son denemesi (boş yer varsa saatte en çok bir kez yeniden dener).
  autoCheckedAt  DateTime?
  createdAt      DateTime        @default(now())
  matches        GameMatch[]
  entries        GameWeekEntry[]

  @@index([season, startsAt])
  @@index([status, startsAt])
}

/// Oyundaki maç — fixture başına TEK satır (`fixtureId` tekil). Haftalık listeye (`weekId` + `position`) ve/veya günlük listeye
/// (`dayId` + `dayPosition`) bağlanır; ikisindeyse tek tahmin iki oyunda da sayılır. En az biri dolu (CHECK).
/// `fixtureId` = MatchSnapshot.fixtureId (Sportmonks id, String). Takım adları/logolar gösterimde snapshot'tan.
/// `kickoffAt` snapshot / önbellekteki gün listesinden güncellenir; KİLİT BU ALANA GÖRE. Skor normal süre (90').
model GameMatch {
  id           String           @id @default(cuid())
  weekId       String?
  week         GameWeek?        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  position     Int?
  dayId        String?
  day          GameDay?         @relation(fields: [dayId], references: [id], onDelete: SetNull)
  dayPosition  Int?
  fixtureId    String           @unique
  kickoffAt    DateTime
  status       GameMatchStatus  @default(SCHEDULED)
  homeGoals    Int?
  awayGoals    Int?
  /// Sonuçlanınca: doğrulanmış hesapların skor dağılımı { "2-1": 14, ..., "_total": 82 } (nadir skor bonusu buna göre).
  distribution Json?
  settledAt    DateTime?
  voidReason   String?
  /// Yedek `fixtures/{id}` sorgusunun son zamanı (saatte en çok bir).
  checkedAt    DateTime?
  predictions  GamePrediction[]

  @@index([status, kickoffAt])
  @@index([weekId])
  @@index([dayId])
}

/// Günlük oyun ("Günün 3 maçı"): İstanbul günü (00:00–24:00). Otomatik seçilir (sonuç işi, lib/game/daily.ts önceliği);
/// joker yok, puan `GamePrediction.basePoints`. O gün aday maç yoksa satır açılmaz (seri bozulmaz).
model GameDay {
  id        String         @id @default(cuid())
  /// "2026-10-19" (İstanbul tarihi)
  dayKey    String         @unique
  /// PUBLISHED | SETTLED (DRAFT kullanılmaz)
  status    GameWeekStatus @default(PUBLISHED)
  startsAt  DateTime
  endsAt    DateTime
  settledAt DateTime?
  createdAt DateTime       @default(now())
  matches   GameMatch[]

  @@index([status, startsAt])
}

/// Kullanıcının bir maça skor tahmini (kullanıcı × maç tek kayıt). `points`/`breakdown` sonuçlanınca yazılır (joker dahil).
model GamePrediction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameMatchId String
  gameMatch   GameMatch @relation(fields: [gameMatchId], references: [id], onDelete: Cascade)
  /// Denormalize (maçın listeleri): haftalık / günlük toplamlar tek tablodan. Maç sonradan güne eklenirse `dayId` güncellenir.
  weekId      String?
  dayId       String?
  home        Int
  away        Int
  /// Kaç kez değiştirildi (kötüye kullanım sinyali).
  revisions   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  /// Haftalık puan (joker dahil). Günlük oyun `basePoints` (jokersiz) kullanır.
  points      Int?
  basePoints  Int?
  /// { dir, diff, total, exact, rare, joker } — lib/game/scoring.ts.
  breakdown   Json?

  @@unique([userId, gameMatchId])
  @@index([gameMatchId])
  @@index([weekId, userId])
  @@index([dayId, userId])
}

/// Kullanıcı × hafta: joker seçimi + sıralama toplamları (sonuçlanan maçlardan yeniden hesaplanır, idempotent).
model GameWeekEntry {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId           String
  week             GameWeek  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  /// Denormalize: sezon tablosu.
  season           String
  jokerGameMatchId String?
  totalPoints      Int       @default(0)
  exactCount       Int       @default(0)
  directionCount   Int       @default(0)
  /// Son tahmin/joker değişikliği (eşitlikte erken karar veren önde).
  lastChangeAt     DateTime  @default(now())
  /// Admin: sıralamadan gizli (satır silinmez).
  hiddenAt         DateTime?
  createdAt        DateTime  @default(now())

  @@unique([userId, weekId])
  @@index([weekId, totalPoints])
  @@index([season, userId])
}
